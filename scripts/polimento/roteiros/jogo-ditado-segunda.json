{
  "nome": "jogo-ditado-segunda",
  "largura": 1280,
  "altura": 960,
  "app": {
    "caminho": "/?ui=pt",
    "guardar": {
      "babel_tour_ditado": "1"
    },
    "passos": [
      {
        "js": "import('/src/lib/theme.ts').then((m) => m.applyDarkMode(false))"
      },
      {
        "esperar": 800
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "clicar": ".q-trilho .q-item >> text=Jogar"
      },
      {
        "esperar": 2500
      },
      {
        "clicar": "button:has-text('Trilha')"
      },
      {
        "esperar": 1200
      },
      {
        "clicar": "button:has-text('Usar estas palavras')"
      },
      {
        "esperar": 2000
      },
      {
        "clicar": ".q-tile[data-jogo='ditado']"
      },
      {
        "esperar": 1800
      },
      {
        "js": "(async()=>{const d=(ms)=>new Promise((r)=>setTimeout(r,ms));{const c=document.querySelector(\".pj-entrada input\");Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(c,\"zzz\");c.dispatchEvent(new Event('input',{bubbles:true}));await d(80);}document.querySelector(\"[data-pj='conferir']\").click();})()"
      }
    ],
    "depois": 250
  },
  "proto": {
    "busca": "?jogo=ditado",
    "passos": [
      {
        "esperar": 800
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 1800
      },
      {
        "js": "(async()=>{const d=(ms)=>new Promise((r)=>setTimeout(r,ms));{const c=document.querySelector(\".pj-entrada input\");Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(c,\"zzz\");c.dispatchEvent(new Event('input',{bubbles:true}));await d(80);}document.querySelector(\"[data-pj='conferir']\").click();})()"
      }
    ],
    "depois": 250
  },
  "seletores": [
    "[data-pj='pontos']",
    "[data-pj='rotulo']",
    ".pj-progresso span",
    ".combo",
    ".pj-entrada",
    ".pj-entrada input",
    ".pj-correcao",
    ".pj-correcao .pj-aviso",
    ".pj-treme",
    ".pj-link"
  ],
