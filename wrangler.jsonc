// O app inteiro como Cloudflare Worker (Fase 2, Task 12): `worker.ts` serve /api/* pelo Express e o resto
// pelos assets do build do Vite. SEMPRE com `-c wrangler.jsonc`: o `wrangler.toml` ao lado é o projeto
// Pages da edição estática (functions/quest/*) e é o que o wrangler acha sozinho.
//   npm run worker:dev    (local: Miniflare simula R2 e assets; Hyperdrive vai ao Postgres local)
//   npm run worker:build  (bundle + relatório de tamanho em dist-worker/)
// Nada de segredo aqui: só ids (que não são segredos) e `vars` públicos. Os secrets vão por
// `wrangler secret put` (produção) ou `.dev.vars` (local, fora do git). Ver docs/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frasy",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  // Com a data ≥ 2025-04-01, os vars/secrets já vêm em process.env; node:fs, AsyncLocalStorage e
  // httpServerHandler também (spike S7).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Perto do Supabase de São Paulo (spike S7: aceito e medido).
  "placement": { "region": "aws:sa-east-1" },
  "observability": { "enabled": true },

  // babel-sp: origem direta no Supabase SP, verify-full com a CA supabase-2021, cache desligado.
  // Local: o `wrangler dev` usa a localConnectionString (ou a variável
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, que tem precedência) — o Postgres 17 de
  // teste em Docker na porta 5433 (senha de teste, não é segredo).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "731fd033ab814021963c4faea04fdd20",
      "localConnectionString": "postgres://postgres:teste@localhost:5433/postgres",
    },
  ],

  // Áudio das sessões e anexos (server/lib/armazenamentoR2.ts).
  "r2_buckets": [{ "binding": "MIDIA", "bucket_name": "frasy-midia" }],

  // Métricas do Worker (server/http/metricasDoAnalyticsEngine.ts); o esquema está em docs/runbook.md.
  "analytics_engine_datasets": [{ "binding": "METRICAS", "dataset": "frasy_metricas" }],

  // O build do Vite. /api/* passa pelo Worker; o resto é estático, e caminho desconhecido cai no
  // index.html (SPA).
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/metrics"],
  },

  // Uma expressão por job de server/jobs/registro.ts (7 distintas: plano Workers Paid). No plano Free
  // (teto de 5), agrupar os diários das 03h numa expressão só — executarJobsDoCron roda em sequência.
  // Local: GET /cdn-cgi/local/scheduled?cron=<expressão>.
  "triggers": {
    "crons": ["5 3 * * *", "7 3 * * *", "11 3 * * *", "13 3 * * *", "17 3 * * *", "23 3 * * *", "19 * * * *"],
  },

  // O que só existe no Node fica fora do bundle: cada pacote vira um stub que lança se for usado
  // (server/stubs/). scripts/worker/build.mjs e tests/worker/bundle.test.ts conferem o resultado.
  // O iconv-lite 0.7 (o 0.4 do Express quebra no workerd) vem do `overrides` do package.json.
  "alias": {
    "@electric-sql/pglite": "./server/stubs/pglite.ts",
    "loopback-capture": "./server/stubs/loopbackCapture.ts",
    "dotenv/config": "./server/stubs/vazio.ts",
    "drizzle-orm/node-postgres/migrator": "./server/stubs/migrador.ts",
    "drizzle-orm/pglite/migrator": "./server/stubs/migrador.ts",
  },

  // O Worker é SEMPRE produção, também no `wrangler dev` e no staging: sem isto o wrangler troca o literal
  // `process.env.NODE_ENV` por "development" no `dev`, e as travas de produção (SECRET_KEY, retenção zero
  // da IA, sandbox do Asaas, /metrics sem token, Langfuse sem conteúdo) ficariam abertas. O `worker.ts`
  // copia o mesmo valor para o process.env do runtime (`fixarModo`).
  // __VERSAO_DO_PACOTE__: a versão do package.json (não há disco no Worker); tests/worker/wrangler.test.ts
  // confere que as duas batem. O sha entra por `GIT_SHA` como var no deploy.
  "define": {
    "process.env.NODE_ENV": "\"production\"",
    "__VERSAO_DO_PACOTE__": "\"0.1.0\"",
  },

  // Só o que é público. O Worker é sempre o modo hospedado (JWT do Supabase).
  "vars": {
    "NODE_ENV": "production",
    "AUTH_REQUIRED": "1",
  },

  // Staging (Fase 4, T5): `npx wrangler deploy -c wrangler.jsonc --env staging`, em
  // https://frasy-staging.guigui-cruzeiro.workers.dev. Bindings e `vars` NÃO são herdados (cada ambiente
  // declara os seus), e o `define` também não (o wrangler avisa): ele se repete aqui, igual ao do topo
  // (tests/worker/wrangler.test.ts confere). `main`, `compatibility_*`, `placement`, `observability`,
  // `assets` e `alias` são herdados (conferido no `wrangler deploy --dry-run --env staging`). O banco é o `frasy_staging` no mesmo
  // Supabase SP, pelo Hyperdrive `frasy-staging-sp` (scripts/cloudflare/hyperdrive-staging.mjs); sem cron.
  // Staging também é produção para as travas (NODE_ENV production).
  "env": {
    "staging": {
      "name": "frasy-staging",
      "workers_dev": true,
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "4c4526a6e2ad4f8a9aff3a8bcbc2f763",
          "localConnectionString": "postgres://postgres:teste@localhost:5433/postgres",
        },
      ],
      "r2_buckets": [{ "binding": "MIDIA", "bucket_name": "frasy-midia-staging" }],
      "analytics_engine_datasets": [{ "binding": "METRICAS", "dataset": "frasy_metricas_staging" }],
      "triggers": { "crons": [] },
      "define": {
        "process.env.NODE_ENV": "\"production\"",
        "__VERSAO_DO_PACOTE__": "\"0.1.0\"",
      },
      "vars": { "NODE_ENV": "production", "AUTH_REQUIRED": "1" },
    },
  },
}
