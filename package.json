{
  "name": "babel-play-web",
  "private": true,
  "version": "0.1.0",
  "description": "Live transcription and translation in the browser (Whisper + Opus-MT via WebGPU/WASM), turned into vocabulary games and spaced repetition.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuilhermeLVL/babel-play"
  },
  "homepage": "https://github.com/GuilhermeLVL/babel-play#readme",
  "keywords": [
    "whisper",
    "webgpu",
    "wasm",
    "transformers-js",
    "onnxruntime-web",
    "speech-to-text",
    "translation",
    "language-learning",
    "local-first",
    "browser-ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "node scripts/copiar-assets-runtime.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p src/core/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src server server.ts tests --max-warnings 0",
    "morto:arquivos": "knip --include files,dependencies,unlisted --no-progress",
    "morto:ciclos": "madge --circular --extensions ts,tsx src server server.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "workflows:validar": "node scripts/validar-workflows.mjs",
    "i18n:pseudo": "node scripts/i18n/pseudo.mjs",
    "i18n:orfas": "node scripts/i18n/orfas.mjs",
    "trilha:derivar": "node scripts/trilha/derivar.mjs",
    "trilha:verificar": "node scripts/trilha/verificar.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev:local": "node subir-dev.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.4",
    "@mozilla/readability": "^0.6.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "compression": "1.8.1",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "idb": "^8.0.3",
    "jose": "^6.2.8",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "loopback-capture": "^2.0.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^5.4.1",
    "jscpd": "5.1.2",
    "knip": "6.34.0",
    "lighthouse": "13.4.1",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
