{
  "nome": "personalizar-conquistas",
  "app": {
    "caminho": "/",
    "passos": [
      {
        "rolar": ".q-trilho .q-item"
      },
      {
        "esperar": 600
      },
      {
        "js": "window.dispatchEvent(new PointerEvent('pointerdown')); [...document.querySelectorAll('.q-trilho .q-item')].find((b) => /Personalizar/.test(b.textContent)).click()"
      },
      {
        "esperar": 6000
      },
      {
        "js": "[...document.querySelectorAll('.qp-abas .q-aba')].find((b) => /Conquistas/.test(b.textContent)).click()"
      },
      {
        "esperar": 2500
      }
    ]
  },
