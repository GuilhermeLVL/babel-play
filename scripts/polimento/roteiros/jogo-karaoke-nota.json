{
  "nome": "jogo-karaoke-nota",
  "largura": 1280,
  "altura": 960,
  "app": {
    "caminho": "/?ui=pt",
    "guardar": {
      "babel_tour_karaoke": "1"
    },
    "passos": [
      {
        "js": "import('/src/lib/theme.ts').then((m) => m.applyDarkMode(false))"
      },
      {
        "esperar": 800
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "clicar": ".q-trilho .q-item >> text=Jogar"
      },
      {
        "esperar": 2500
      },
      {
        "clicar": "button:has-text('Trilha')"
      },
      {
        "esperar": 1200
      },
      {
        "clicar": "button:has-text('Usar estas palavras')"
      },
      {
        "esperar": 2000
      },
      {
        "clicar": ".q-tile[data-jogo='karaoke']"
      },
      {
        "esperar": 1800
      },
      {
        "js": "(()=>{window.SpeechRecognition=window.webkitSpeechRecognition=class{start(){setTimeout(()=>{this.onresult({results:[[{transcript:[...document.querySelectorAll('.pj-frase span')].map((s)=>s.textContent).join(' ')}]]});this.onend()},400)}stop(){}abort(){}}})()"
      },
      {
        "js": "(async()=>{const d=(ms)=>new Promise((r)=>setTimeout(r,ms));document.querySelector(\"[data-pj='falar']\").click();})()"
      }
    ],
    "depois": 900
  },
  "proto": {
    "busca": "?jogo=karaoke",
    "passos": [
      {
        "esperar": 800
      },
      {
        "tecla": "Escape"
      },
      {
        "esperar": 1800
      },
      {
        "js": "(async()=>{const d=(ms)=>new Promise((r)=>setTimeout(r,ms));document.querySelector(\"[data-pj='falar']\").click();})()"
      }
    ],
    "depois": 2900
  },
  "seletores": [
    "[data-pj='pontos']",
    "[data-pj='rotulo']",
    ".pj-progresso span",
    ".combo",
    ".ganho",
    ".fx-vinheta",
    ".pj-nota",
    ".pj-pct",
    ".pj-nota p",
    ".pj-nota small",
    ".pj-frase span.certa"
  ],
  "props": [
    "textDecorationLine",
    "borderTopStyle",
    "animationDelay"
  ]
}
