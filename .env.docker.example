# Modo PÚBLICO multi-usuário. Copie para `.env.docker` e preencha.
# `.env.docker` NÃO vai para o git (ver .gitignore) nem para a imagem (ver .dockerignore).

# ─── OBRIGATÓRIAS ─────────────────────────────────────────────────────────────

# Cifra os segredos BYOK em repouso. Em produção o boot ABORTA sem ela (server/crypto.ts).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Identidade (Supabase é usado APENAS como IdP — não há banco Supabase).
# O JWT é verificado localmente pelo JWKS assimétrico a partir de SUPABASE_URL. NÃO defina
# SUPABASE_JWT_SECRET junto: com a URL ele fica inerte (projeto legado HS256 é o único caso dele).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Admin API: desfazer o login na exclusão de conta e exigir 2FA (AAL2) de quem o ativou.
SUPABASE_SERVICE_ROLE_KEY=

# Quantos proxies reversos há na frente do container. OBRIGATÓRIA com NODE_ENV=production (o boot
# aborta sem): 1 atrás de um Caddy/Nginx no host; `false` se o container recebe a conexão direto.
TRUST_PROXY=1

# O cliente (SPA) precisa destas em BUILD TIME — o Vite as embute no bundle.
# A anon key é pública por design; o que protege é o RLS/policies do Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REQUIRED=1

# ─── IA GERENCIADA (opcional) ─────────────────────────────────────────────────
# Sem chave, os proxies respondem 501 e o cliente cai na cadeia local — o app funciona.
# COM chave, ela é SUA e paga: os tetos por plano estão mais abaixo (PREMIUM_*).

GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_LLM_MODEL=openai/gpt-oss-120b   # a Groq aposentou todos os Llama em ago/2026; gpt-oss-120b e gpt-oss-20b são os atuais
# STT_MODEL=whisper-large-v3-turbo

# O Gemini saiu da cascata do tutor (os termos dele proíbem apps usados por menores).

# ─── JÁ DEFINIDAS NA IMAGEM (só sobrescreva se souber por quê) ────────────────
# DATABASE_URL=file:/data/babel.db
# AUDIO_DIR=/data/audio
# HOST=0.0.0.0
# PORT=3000

# Isolamento de origem → WASM multithread do Whisper local: LIGADO por padrão (COOP + COEP
# credentialless + Document-Isolation-Policy); os pesos de outra origem vêm por CORS e continuam
# carregando. `dip` = só o DIP (Chrome/Edge); `0` desliga (server/http/isolamento.ts).
# CROSS_ORIGIN_ISOLATION=0

# --- Provedor de LLM (tradução e tutor) -------------------------------------
# O corpo da requisição é OpenAI-compatible puro: trocar de provedor é trocar estas
# três variáveis, sem uma linha de código. Os nomes GROQ_* seguem funcionando.
#
# MEDIDO: o MESMO gpt-oss-120b custa US$ 0,029 por mil falas no OpenRouter contra
# US$ 0,107 na Groq. Ver docs/auditoria/eval-modelos-v1.md.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b

# Tetos do plano Premium (matriz v2, ADR 0011: 40 h/mês, o empate de custo, e o uso justo
# de 2 h por dia local). O de SEGUNDOS é o que controla gasto: o provedor cobra STT por
# duração (mínimo 10 s por trecho), então teto em chamadas não limita dinheiro. Sem valor,
# vale a matriz de src/core/planos.ts (a fonte única). A reserva é atômica: 20 requisições
# simultâneas contra teto 5 aceitam 5, não 20. As ESSENCIAL_* e PRO_* não são mais lidas.
# PREMIUM_MONTHLY_MANAGED_CALLS=50000
# PREMIUM_MONTHLY_STT_SECONDS=144000
# PREMIUM_DAILY_STT_SECONDS=7200
# PREMIUM_STORAGE_MB=5000

# --- Reserva do LLM (cascata) ------------------------------------------------
# O primário pode ser barato ou gratuito (o minimax-m3:free EMPATOU com o pago na
# bancada), mas camada gratuita é intermitente. Com as TRÊS definidas, falha do
# primário (429/5xx/vazio/timeout) cai para a reserva; sem elas, nada muda.
# LLM_RESERVA_BASE_URL=https://api.groq.com/openai/v1
# LLM_RESERVA_API_KEY=
# LLM_RESERVA_MODEL=openai/gpt-oss-120b

# --- Cobrança (Asaas) --------------------------------------------------------
# SANDBOX por padrão (errar para o lado do sandbox custa um teste; para o da
# produção, uma cobrança real). Produção: ASAAS_BASE_URL=https://api.asaas.com/v3
# O ASAAS_WEBHOOK_TOKEN é o segredo que VOCÊ define ao cadastrar o webhook no
# painel do Asaas (authToken) — sem ele o webhook recusa tudo.
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=

# --- Instalação pessoal SEM login -------------------------------------------
# Este compose é o modo PÚBLICO (AUTH_REQUIRED=1 fixo no docker-compose.yml). Para rodar a imagem
# só para você, sem login, com NODE_ENV=production: AUTH_REQUIRED=0 E SELF_HOST=1, os dois — um
# AUTH_REQUIRED=0 sozinho aborta o boot (GAP-003), justamente para não subir aberto por engano.
# AUTH_REQUIRED=0
# SELF_HOST=1
