# Modo PÚBLICO multi-usuário. Copie para `.env.docker` e preencha.
# `.env.docker` NÃO vai para o git (ver .gitignore) nem para a imagem (ver .dockerignore).

# ─── OBRIGATÓRIAS ─────────────────────────────────────────────────────────────

# Cifra os segredos BYOK em repouso. Em produção o boot ABORTA sem ela (server/crypto.ts).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Identidade (Supabase é usado APENAS como IdP — não há banco Supabase).
# O JWT é verificado localmente: JWKS a partir de SUPABASE_URL, ou HS256 com o segredo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_JWT_SECRET=

# O cliente (SPA) precisa destas em BUILD TIME — o Vite as embute no bundle.
# A anon key é pública por design; o que protege é o RLS/policies do Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REQUIRED=1

# ─── IA GERENCIADA (opcional) ─────────────────────────────────────────────────
# Sem chave, os proxies respondem 501 e o cliente cai na cadeia local — o app funciona.
# COM chave, ela é SUA e paga: o teto por usuário está em PRO_MONTHLY_MANAGED_CALLS.

GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_LLM_MODEL=openai/gpt-oss-120b   # llama-3.3-70b virou enterprise-only na Groq
# STT_MODEL=whisper-large-v3-turbo

# GEMINI_API_KEY=

# Teto MENSAL de chamadas gerenciadas por usuário Pro (default 1000).
# A reserva é atômica: 20 requisições simultâneas contra teto 5 aceitam 5, não 20.
PRO_MONTHLY_MANAGED_CALLS=1000

# ─── JÁ DEFINIDAS NA IMAGEM (só sobrescreva se souber por quê) ────────────────
# DATABASE_URL=file:/data/babel.db
# AUDIO_DIR=/data/audio
# HOST=0.0.0.0
# PORT=3000

# Habilita SharedArrayBuffer → WASM multithread do Whisper local (decode mais rápido).
# Exige servir os pesos same-origin; pode bloquear recursos cross-origin. Opt-in.
# CROSS_ORIGIN_ISOLATION=1

# --- Provedor de LLM (tradução e tutor) -------------------------------------
# O corpo da requisição é OpenAI-compatible puro: trocar de provedor é trocar estas
# três variáveis, sem uma linha de código. Os nomes GROQ_* seguem funcionando.
#
# MEDIDO: o MESMO gpt-oss-120b custa US$ 0,029 por mil falas no OpenRouter contra
# US$ 0,107 na Groq. Ver docs/auditoria/eval-modelos-v1.md.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b

# Tetos do plano Pro. O de SEGUNDOS é o que controla gasto: o provedor cobra STT por
# duração (mínimo 10 s por trecho), então teto em chamadas não limita dinheiro.
# PRO_MONTHLY_MANAGED_CALLS=12000
# PRO_MONTHLY_STT_SECONDS=36000

# Tetos do plano Essencial (defaults da matriz em src/core/planos.ts: 12000 chamadas,
# 0 segundos de STT de nuvem — é o zero que faz o plano custar < R$ 1/usuário —, 1 GB).
# ESSENCIAL_MONTHLY_MANAGED_CALLS=12000
# ESSENCIAL_MONTHLY_STT_SECONDS=0
# ESSENCIAL_STORAGE_MB=1000
