      {
        "js": "(() => { const f = window.fetch; window.fetch = async (...a) => { const r = await f(...a); const u = typeof a[0] === 'string' ? a[0] : a[0].url; const m = (a[1] && a[1].method) || (a[0] && a[0].method) || 'GET'; if (!String(u).includes('/api/settings') || m !== 'GET') return r; const c = await r.clone().json().catch(() => null); if (!c || typeof c.ui !== 'string') return r; const ui = { ...JSON.parse(c.ui), captureSourceLang: 'pt-BR' }; return new Response(JSON.stringify({ ...c, targetLanguage: 'en', ui: JSON.stringify(ui) }), { status: 200, headers: { 'Content-Type': 'application/json' } }); }; })()"
      },
      {
        "js": "import('/src/lib/theme.ts').then((m) => m.applyDarkMode(false))"
