# Porta do servidor (dev). FIXE uma porta: o cache dos modelos locais é por porta.
PORT=3000

# Interface de escuta. Padrão 127.0.0.1 (só esta máquina). HOST=0.0.0.0 expõe o app
# à rede local SEM autenticação — inclusive suas sessões, credenciais e o áudio do
# sistema. Só use em rede confiável e de propósito.
# HOST=127.0.0.1

# Saltos de proxy reverso em que confiar para resolver o IP do cliente (`req.ip`).
# LIGUE SÓ SE HOUVER PROXY NA FRENTE (Nginx, Caddy, Cloudflare): sem ele, o cliente
# passa a escolher o próprio `X-Forwarded-For` e o limitador de taxa deixa de existir.
# Com proxy e SEM esta variável, todo mundo chega com o IP do proxy e divide o mesmo
# balde do limitador e da trava do ranking. `1` = um proxy; aceita também `true`,
# `false`, `loopback` ou uma lista de sub-redes. Com NODE_ENV=production ela é OBRIGATÓRIA
# (o boot aborta sem): declare `false` se não houver proxy nenhum.
# TRUST_PROXY=1

# Banco local (SQLite). Portável a Postgres/Supabase trocando o driver do Drizzle.
DATABASE_URL=file:./data/babel.db
# DATABASE_AUTH_TOKEN=                    # só para banco remoto libsql (Turso): DATABASE_URL=libsql://<db>.turso.io

# Onde ficam os áudios gravados das sessões. Sem valor: ./data/audio (relativo ao cwd).
# Com MAIS DE UMA RÉPLICA, aponte TODAS para o mesmo volume compartilhado — senão o áudio
# gravado numa réplica devolve 404 na outra (a linha do banco replica, o arquivo não).
# Réplicas em hosts SEM storage comum exigem object store (S3/R2) — ainda não implementado.
# AUDIO_DIR=/mnt/compartilhado/babel/audio

# Chave que cifra os segredos (credenciais BYOK) em repouso. Em dev, se ausente, uma
# chave aleatória é gerada e persistida em data/secret.key. Em PRODUÇÃO é OBRIGATÓRIA.
# SECRET_KEY=

# STT de nuvem (PADRÃO para áudio do sistema — funciona em qualquer navegador/dispositivo,
# sem download, sem WebGPU). A chave fica SÓ no servidor; os usuários não precisam de chave.
# Pegue uma grátis em https://console.groq.com/keys (free-tier generoso).
GROQ_API_KEY=
# Opcionais (defaults já apontam para a Groq):
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=openai/gpt-oss-120b   # a Groq aposentou todos os Llama em ago/2026; gpt-oss-120b e gpt-oss-20b são os atuais

# Importação de YouTube: caminho do binário yt-dlp quando não está no PATH.
# YTDLP_PATH=C:/caminho/para/yt-dlp.exe

# COOP/COEP para SharedArrayBuffer (WASM multithread) — ligue só em deploy próprio
# com modelos self-hosted (senão bloqueia recursos cross-origin).
# CROSS_ORIGIN_ISOLATION=1

# ─────────────────────────── Marco 1: autenticação + multi-tenant ───────────────────────────
# DESLIGADO por padrão = self-host/local: sem login, todo request é o "dono local", app roda
# como sempre. Ligue TUDO abaixo só para um deploy PÚBLICO (SaaS), onde cada usuário tem conta.
#
# Servidor:
# AUTH_REQUIRED=1                         # exige JWT do Supabase em TODA rota /api (senão 401).
#                                         # Em NODE_ENV=production já liga por padrão.
# SELF_HOST=1                             # SÓ instalação pessoal: com NODE_ENV=production, subir SEM
#                                         # login (AUTH_REQUIRED=0) é aceito apenas com SELF_HOST=1
#                                         # declarado junto — um AUTH_REQUIRED=0 esquecido sozinho
#                                         # aborta o boot (GAP-003). Nunca no SaaS público.
# SUPABASE_URL=https://SEUPROJ.supabase.co   # deriva o JWKS (verificação assimétrica) e o issuer.
# SUPABASE_JWT_SECRET=                    # SÓ se o projeto usar o segredo HS256 legado (fallback).
# LOCAL_OWNER_ID=local-owner              # dono das linhas legadas no self-host (raramente mexer).
#
# Cliente (precisa do prefixo VITE_ para chegar ao bundle):
# VITE_SUPABASE_URL=https://SEUPROJ.supabase.co
# VITE_SUPABASE_ANON_KEY=                 # chave pública "anon" do projeto Supabase.
# VITE_AUTH_REQUIRED=1                    # mostra a tela de login (espelha o AUTH_REQUIRED acima).

# Object storage da mídia (F5-02). As QUATRO precisam estar presentes; pela metade,
# cai para filesystem em AUDIO_DIR.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Exclusão de conta (LGPD Art. 18 VI, F9-01): sem esta chave o DELETE /api/me apaga os dados
# mas NÃO revoga o login no Supabase — a conta se recria vazia no próximo acesso. A rota avisa
# em vez de fingir sucesso.
SUPABASE_SERVICE_ROLE_KEY=

# Reconciliação do contador de armazenamento (F9-02). 0 desliga.
STORAGE_RECONCILE_HOURS=24

# Modo cluster (F6-01). Vazio ou 1 = um processo.
CLUSTER_WORKERS=

# --- Provedor de LLM (tradução e tutor) -------------------------------------
# O corpo da requisição é OpenAI-compatible puro: trocar de provedor é trocar estas
# três variáveis, sem uma linha de código. Os nomes GROQ_* seguem funcionando.
#
# MEDIDO: o MESMO gpt-oss-120b custa US$ 0,029 por mil falas no OpenRouter contra
# US$ 0,107 na Groq. Ver docs/auditoria/eval-modelos-v1.md.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b

# O modelo entregue a quem tem o entitlement `largerModels` (planos pro e selfhost).
# AUSENTE, TODO PLANO RECEBE O MESMO MODELO de LLM_MODEL — que era o comportamento
# ate a Fase 4, quando `largerModels` estava na matriz de planos e nenhuma linha do
# servidor o lia. Qual modelo vale a diferenca de preco e decisao de produto.
# LLM_MODEL_GRANDE=

# Tetos por plano (defaults e a CONTA DE CUSTO em src/core/planos.ts). SEGUNDOS e TOKENS
# são o que controla gasto: o provedor cobra STT por duração (mínimo 10 s por trecho) e
# LLM por token; chamadas é fair-use.
# Pro R$ 39,90: 20 h de transcrição, 5M tokens, modelo maior (LLM_MODEL_GRANDE).
# PRO_MONTHLY_MANAGED_CALLS=26000
# PRO_MONTHLY_STT_SECONDS=72000
# PRO_MONTHLY_LLM_TOKENS=5000000
#
# Essencial R$ 19,90: 15 h de transcrição, 3M tokens, modelo padrão.
# ESSENCIAL_MONTHLY_MANAGED_CALLS=20000
# ESSENCIAL_MONTHLY_STT_SECONDS=54000
# ESSENCIAL_MONTHLY_LLM_TOKENS=3000000
# ESSENCIAL_STORAGE_MB=1000

# --- Chave de emergência e orçamento global da IA de nuvem -------------------
# AI_ENABLED=0 desliga TODA IA de nuvem na hora (tradução, transcrição, tutor): as
# rotas respondem 503 com o motivo e o app segue com os modelos locais. Ausente = ligada.
# AI_ENABLED=1
#
# Teto de gasto ESTIMADO do mês, em US$ (tabela gasto_de_ia). A 80% o log emite
# ia_orcamento_alerta_80; a 100% emite ia_orcamento_esgotado e a nuvem desliga até
# o mês virar. Ausente: US$ 20 no modo público, sem teto no self-host. 0 = sem nuvem.
# Mantenha TAMBÉM o teto de gasto no painel do Groq e o crédito pré-pago do OpenRouter.
# AI_BUDGET_USD_MONTH=20
#
# Preço por modelo usado na estimativa (sobrepõe a tabela oficial embutida):
# LLM em US$ por 1M tokens {entrada, saida}; STT em US$ por hora {hora}.
# AI_PRECOS_MODELOS={"openai/gpt-oss-120b":{"entrada":0.15,"saida":0.60},"whisper-large-v3-turbo":{"hora":0.04}}

# --- Reserva do LLM (cascata) ------------------------------------------------
# O primário pode ser barato ou gratuito (o minimax-m3:free EMPATOU com o pago na
# bancada), mas camada gratuita é intermitente. Com as TRÊS definidas, falha do
# primário (429/5xx/vazio/timeout) cai para a reserva; sem elas, nada muda.
# LLM_RESERVA_BASE_URL=https://api.groq.com/openai/v1
# LLM_RESERVA_API_KEY=
# LLM_RESERVA_MODEL=openai/gpt-oss-120b
#
# ATALHO da reserva escolhida para o lançamento: só a chave do OpenRouter. Base
# https://openrouter.ai/api/v1 e o modelo de LLM_RESERVA_MODEL (ou openai/gpt-oss-120b).
# Use crédito PRÉ-PAGO sem recarga automática e retenção zero ligada no painel.
# As três LLM_RESERVA_* completas vencem o atalho.
# OPENROUTER_API_KEY=
#
# O Gemini SAIU (Fase 2 do lançamento): o app é aberto a menores e os termos dele
# proíbem esse uso. O tutor usa a mesma cascata da tradução (Groq → OpenRouter).

# --- Cobrança (Asaas) --------------------------------------------------------
# SANDBOX por padrão (errar para o lado do sandbox custa um teste; para o da
# produção, uma cobrança real). Produção: ASAAS_BASE_URL=https://api.asaas.com/v3
# O ASAAS_WEBHOOK_TOKEN é o segredo que VOCÊ define ao cadastrar o webhook no
# painel do Asaas (authToken) — sem ele o webhook recusa tudo.
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=

# --- Armazenamento de objetos (S3-compativel: R2, MinIO, S3) ------------------
# Com mais de uma replica, o audio PRECISA estar aqui: gravado no disco local, ele
# nao existe na outra instancia e o mesmo pedido responde 200 ou 404 conforme quem
# atendeu. As quatro sao necessarias para o seam ligar; S3_REGION cai em "auto".
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Topologia ---------------------------------------------------------------
# REPLICAS declara quantas INSTANCIAS independentes existem (nao processos: para
# processos no mesmo host, use CLUSTER_WORKERS). Acima de 1, o boot EXIGE
# armazenamento alcancavel por todas — S3 acima, ou a declaracao abaixo de que as
# replicas montam o MESMO volume. Sem isso o servidor recusa subir, de proposito:
# servir audio que some conforme o balanceador e pior que nao servir.
# REPLICAS=1
# ARMAZENAMENTO_COMPARTILHADO=0

# A varredura que reconcilia o contador de armazenamento e O(n sessoes) e rodava
# dentro de GET /api/me/entitlements — trabalho de limpeza pago pela latencia de
# quem esta usando o app. Em "job" ela sai desse caminho e quem opera chama
# POST /api/admin/armazenamento/reconciliar por cron.
# STORAGE_RECONCILE_MODE=oportunista

# Midia importada do Anki. Sem ela, data/anki-media (preso ao disco da replica).

# --- Observabilidade ---------------------------------------------------------
# GET /metrics no formato Prometheus. NA RAIZ, e nao /api/metrics — essa ja existe
# e e a rota de NEGOCIO (perfil, seeds), atras do auth.
#
# Ausente ou diferente de 1, a rota NAO E MONTADA: /metrics responde o mesmo 404 de
# qualquer caminho desconhecido. E de proposito — uma rota montada respondendo 403
# confirmaria a um estranho que o servidor e instrumentado.
# METRICS_ENABLED=1
#
# Segredo do `Authorization: Bearer <token>` do scrape (comparacao em tempo
# constante). Sem ele o scrape e ABERTO: aceitavel no self-host e em rede interna
# fechada, e NAO em rede publica — o corpo de um scrape descreve todas as rotas do
# servidor, o volume de cada uma e a taxa de erro.
# METRICS_TOKEN=
#
# EM CLUSTER, o /metrics responde os numeros DO PROCESSO que atendeu o scrape, e
# diz qual foi (header x-metrics-processo e metrica processo_info). Ver o bloco de
# cluster em server/http/metricas.ts para o porque de nao haver agregacao.

# --- Desligamento ------------------------------------------------------------
# Teto em ms para drenar as conexoes em curso depois do SIGTERM. Estourado, o
# processo sai com 1 — a requisicao foi abandonada e o codigo de saida e o unico
# canal para dizer isso.
#
# 10.000 e o padrao porque e o prazo que o `docker stop` da antes do SIGKILL:
# um teto maior que ele nunca chega a ser usado. Ajuste quem roda com
# `docker stop -t` menor ou `terminationGracePeriodSeconds` diferente.
# DESLIGAMENTO_TIMEOUT_MS=10000

# --- LLM local ---------------------------------------------------------------
# Endereco do Ollama. Estava cravado no codigo em dois lugares ate 07/09.
# OLLAMA_URL=http://localhost:11434/v1

