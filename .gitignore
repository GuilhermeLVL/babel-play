# ── Dependências / build ─────────────────────────────────────────────────────
node_modules/
dist/
dist-server/
dist-ssr/
.vite/
*.tsbuildinfo

# ── Ambiente e segredos: NUNCA versionar. Só os templates *.example entram. ──
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.*
.claude/settings.local.json
# Configuração de MCP contém identificadores de projeto pessoais (project_ref do Supabase).
.mcp.json

# ── Binários de runtime copiados de node_modules (scripts/copiar-assets-runtime.mjs) ──
# Eram 42 MB versionados. `npm install` os recria; o Dockerfile também.
/public/ort-wasm-*
/public/silero_vad_*.onnx
/public/vad.worklet.bundle*
# Pesos dos modelos (scripts/fetch-models.mjs; Docker assa na imagem)
/public/models/

# ── Banco local (SQLite) e dados — SÓ o diretório do root (não src/data/) ───
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
backups/

# ── Artefatos de medição/auditoria: vivem no repositório PRIVADO de auditoria ─
# (no público estes diretórios não existem; aqui evitam artefato solto em commit)
results/
scripts/audit/results/
audit/evidence/
audit/baseline/golden-ci/
docs/auditoria/_raw/
.playwright-mcp/
test-results/
playwright-report/
coverage/
.cache-canario/
.deepeval/
.deepeval_telemetry.txt

# ── Projetos vizinhos que moram nesta pasta mas não neste repositório ────────
desktop-overlay/
assets/

# ── Fixtures com conteúdo real do usuário (regenere com `npm run proto:fixtures`) ─
prototypes/data/real/

# ── Logs / SO / editor / OneDrive ────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
.vscode/
!.vscode/extensions.json
.idea/
hub-leve.png
.playwright-mcp/

# Áudio do corpus de avaliação (baixado por scripts/eval-fala/baixar-corpus.py) e cenários gerados.
# Os MANIFESTOS são versionados; o áudio, não.
tests/fixtures/audio/
tests/fixtures/cenarios-diarizacao/*.wav
docs/auditoria/eval/resultados-*.json

# Corpus FLORES-200 (baixado por scripts/eval-fala/baixar-flores.mjs; manifesto versionado)
tests/fixtures/flores/*.jsonl

# Saída do grafo (graphify) — reconstruível, não versionar
graphify-out/

# Cópias de segurança geradas por scripts/backup.mjs
backups/

# Worktrees do git criados sob .claude/ — são cópias de trabalho, não conteúdo do repositório.
# Versioná-los duplicaria a árvore inteira dentro dela mesma.
.claude/worktrees/

# Sobras de bancada: nao versionadas, e sem isto apareciam como untracked a cada `git status`.
scratch_test/
.wrangler/
vitest-resultado.json

# Fixture anonimizada do banco (gerada por scripts/db/fixture-anonimizada.mjs); e a unica excecao ao *.db
!tests/fixtures/banco-estado-atual.db
data/gate-e2e.db*
