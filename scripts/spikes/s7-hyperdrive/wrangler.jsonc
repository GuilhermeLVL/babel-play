// Spike S7 (descartável). Deploy: `npx wrangler deploy -c scripts/spikes/s7-hyperdrive/wrangler.jsonc`.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "spike-s7",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "SPIKE_VAR": "x" },
  // Express 4 puxa iconv-lite 0.4 (quebra no workerd); 0.7 instalado só aqui com `npm i --no-save`.
  "alias": { "iconv-lite": "./node_modules/iconv-lite" },
  "placement": { "region": "aws:sa-east-1" },
  // babel-sp: origem direta db.<ref>.supabase.co (IPv6), verify-full com a CA supabase-2021, cache desligado
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "731fd033ab814021963c4faea04fdd20" }],
}
