{
  "nome": "agua-inicio-celular",
  "largura": 390,
  "altura": 844,
  "toque": true,
  "app": {
    "caminho": "/",
    "guardar": {
      "babel.px.planoDeProva": "free",
      "app_theme": "agua"
    },
    "passos": [
      {
        "js": "import('/src/lib/polimento/agua.ts').then((a) => { window.__agua = window.__agua || a.instalarAgua() })"
      },
      {
        "esperar": 1200
      },
      {
        "js": "import('/src/lib/theme.ts').then((t) => t.applyDarkMode(false))"
      },
      {
        "esperar": 800
      },
      {
        "js": "document.dispatchEvent(new PointerEvent('pointermove', { clientX: innerWidth / 2, clientY: innerHeight * 0.45, bubbles: true }))"
      },
      {
        "esperar": 6500
      },
      {
        "js": "document.getAnimations().forEach((a) => { if (String(a.animationName || '').startsWith('ag-')) { a.pause(); a.currentTime = 0 } })"
      },
      {
        "esperar": 300
      }
    ]
  },
  "proto": {
    "passos": [
      {
        "js": "document.querySelector(\"[data-px-acao='agua']\").click()"
      },
      {
        "esperar": 1500
      },
      {
        "js": "document.querySelector('.px-barra')?.style.setProperty('display', 'none'); HTMLElement.prototype.find = () => undefined"
      },
      {
        "js": "document.dispatchEvent(new PointerEvent('pointermove', { clientX: innerWidth / 2, clientY: innerHeight * 0.45, bubbles: true }))"
      },
      {
        "esperar": 6500
      },
      {
        "js": "document.getAnimations().forEach((a) => { if (String(a.animationName || '').startsWith('ag-')) { a.pause(); a.currentTime = 0 } })"
      },
      {
        "esperar": 300
      },
      {
        "js": "document.querySelector('.px-barra')?.style.setProperty('display', 'none')"
      }
    ]
  },
  "props": [
    "order",
    "flexGrow",
    "flexBasis",
    "minHeight",
    "marginTop",
    "left",
    "right",
    "bottom",
    "zIndex",
    "justifyContent",
    "alignItems",
    "overflowX",
    "width",
    "height",
    "gridTemplateColumns",
    "scrollSnapType",
    "flexWrap",
    "maxHeight",
    "touchAction",
    "maskImage",
    "mixBlendMode",
    "filter",
    "contain",
    "pointerEvents",
    "backgroundSize",
    "animationDirection",
    "animationTimingFunction",
    "animationIterationCount",
    "animationDelay",
    "top",
    "willChange",
    "transformOrigin"
  ],
  "seletores": [
    {
      "app": "main",
      "proto": "main",
      "nome": "main (fundo)"
    },
    ".px-aura",
    ".ag-cena",
    ".ag-raios",
    ".ag-raios i",
    ".ag-raios i + i",
    ".ag-caustica.a",
    ".ag-caustica.a i",
    ".ag-caustica.b",
    ".ag-caustica.b i",
    "canvas.ag-bolhas",
    "canvas.ag-mar",
    ".ag-frente",
    ".ag-brilho",
    ".q-trilho",
    ".q-trilho .q-item",
    ".q-trilho .px-pilula",
    ".q-cab h1",
    ".q-cab .q-sobre",
    ".px-plano-chip",
    ".q-grade.g3.q-cresce",
    ".q-tile.pri",
    ".q-tile.pri .q-ic",
    ".q-tile:not(.pri)",
    ".q-tile b",
    ".q-tile .q-d",
    "[data-testid='progresso-no-inicio']",
    ".q-barra",
    ".q-palco",
    ".q-cab",
    ".q-tile:not(.pri) b",
    ".q-tile:not(.pri) .q-d",
    "[data-testid='progresso-no-inicio'] > span:nth-child(2)",
    "[data-testid='progresso-no-inicio'] > .q-fim",
    "[data-testid='missoes-no-inicio']",
    "[data-testid='missoes-no-inicio'] > .q-grade",
    "[data-testid='missoes-no-inicio'] > .q-grade > *",
    ".q-secao h2",
    ".q-barra > span",
    ".q-tile:not(.pri) .q-ic"
  ]
}
