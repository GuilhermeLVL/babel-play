  "altura": 960,
  "app": {
    "caminho": "/?ui=pt",
    "guardar": {
      "babel_tour_tenis": "1"
    },
    "passos": [
      {
        "js": "import('/src/lib/theme.ts').then((m) => m.applyDarkMode(false))"
