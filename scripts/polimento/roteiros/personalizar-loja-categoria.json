{
  "nome": "personalizar-loja-categoria",
  "app": {
    "caminho": "/",
    "guardar": {
      "babel.liberado": "0"
    },
    "passos": [
      {
        "js": "(() => { const f = window.fetch.bind(window); window.fetch = async (...a) => { const r = await f(...a); try { const u = String((a[0] && a[0].url) || a[0]); if (u.indexOf('/api/metrics/profile') >= 0) { const j = await r.clone().json(); if (j && typeof j === 'object') { j.seedsGastas = (j.seedsGastas || 0) - 403; return new Response(JSON.stringify(j), { status: r.status, headers: { 'Content-Type': 'application/json' } }); } } } catch (e) {} return r; }; window.dispatchEvent(new CustomEvent('babel:metricas-mudaram')); })()"
      },
      {
        "esperar": 1500
      },
      {
        "rolar": ".q-trilho .q-item"
      },
      {
        "esperar": 600
      },
      {
        "js": "window.dispatchEvent(new PointerEvent('pointerdown')); [...document.querySelectorAll('.q-trilho .q-item')].find((b) => /Personalizar/.test(b.textContent)).click()"
      },
      {
        "esperar": 6000
      },
      {
        "js": "[...document.querySelectorAll('.qp-abas .q-aba')].find((b) => /Loja/.test(b.textContent)).click()"
      },
      {
        "esperar": 2500
      }
    ]
  },
  "proto": {
    "passos": [
      {
        "rolar": ".q-trilho .q-item"
      },
      {
        "esperar": 600
      },
      {
        "js": "window.dispatchEvent(new PointerEvent('pointerdown')); [...document.querySelectorAll('.q-trilho .q-item')].find((b) => /Personalizar/.test(b.textContent)).click()"
      },
      {
        "esperar": 6000
      },
      {
        "js": "[...document.querySelectorAll('.qp-abas .q-aba')].find((b) => /Loja/.test(b.textContent)).click()"
      },
      {
        "esperar": 2500
      }
    ]
  },
  "props": [
    "marginTop",
    "marginBottom",
    "alignItems",
    "justifyContent",
    "flexGrow",
    "maxWidth",
    "borderTopStyle",
    "textTransform"
  ],
  "seletores": [
    ".px-cats",
    ".px-loja"
  ],
