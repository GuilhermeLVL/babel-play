{
  "nome": "interprete-automatico-celular-escuro",
  "largura": 390,
  "altura": 844,
  "app": {
    "caminho": "/",
    "guardar": {
      "babel.interprete.modo": "toque",
      "babel.interprete.virtual": "sim"
    },
    "passos": [
      {
        "tecla": "Escape"
      },
      {
        "esperar": 500
      },
      {
        "js": "import('/src/lib/i18n.ts').then((m) => m.usarIdioma('pt'))"
      },
      {
        "esperar": 500
      },
      {
        "js": "import('/src/lib/theme.ts').then((m) => m.applyDarkMode(true))"
      },
      {
        "js": "[...document.querySelectorAll('.q-trilho .q-item')].find((b) => /Intérprete/.test(b.textContent)).click()"
      },
      {
        "esperar": 2500
      },
      {
        "clicar": "[aria-label^='Modo automático']"
      },
      {
        "esperar": 300
      }
    ],
    "depois": 100
  },
  "proto": {
    "passos": [
      {
        "texto": "Tema"
      },
      {
        "js": "document.querySelector(\"[data-px='planos']\").click()"
      },
      {
        "esperar": 900
      },
      {
        "js": "document.querySelector(\"[data-px='teste']\").click()"
      },
      {
        "esperar": 900
      },
      {
        "js": "[...document.querySelectorAll('.q-trilho .q-item')].find((b) => /Intérprete/.test(b.textContent)).click()"
      },
      {
        "esperar": 2500
      },
      {
        "clicar": "[aria-label^='Modo automático']"
      },
      {
        "esperar": 300
      }
    ],
    "depois": 100
  },
  "seletores": [
    ".int-faixa",
    ".int-esq",
    ".int-centro",
    ".int-aviso",
    ".int-voz",
    "[aria-label^='Modo automático']",
    "[aria-label='Sair do modo intérprete']"
  ]
}
