# Porta do servidor (dev). FIXE uma porta: o cache dos modelos locais é por porta.
PORT=3000

# Interface de escuta. Padrão 127.0.0.1 (só esta máquina). HOST=0.0.0.0 expõe o app
# à rede local SEM autenticação — inclusive suas sessões, credenciais e o áudio do
# sistema. Só use em rede confiável e de propósito.
# HOST=127.0.0.1

# Banco local (SQLite). Portável a Postgres/Supabase trocando o driver do Drizzle.
DATABASE_URL=file:./data/babel.db
# DATABASE_AUTH_TOKEN=                    # só para banco remoto libsql (Turso): DATABASE_URL=libsql://<db>.turso.io

# Onde ficam os áudios gravados das sessões. Sem valor: ./data/audio (relativo ao cwd).
# Com MAIS DE UMA RÉPLICA, aponte TODAS para o mesmo volume compartilhado — senão o áudio
# gravado numa réplica devolve 404 na outra (a linha do banco replica, o arquivo não).
# Réplicas em hosts SEM storage comum exigem object store (S3/R2) — ainda não implementado.
# AUDIO_DIR=/mnt/compartilhado/babel/audio

# Chave que cifra os segredos (credenciais BYOK) em repouso. Em dev, se ausente, uma
# chave aleatória é gerada e persistida em data/secret.key. Em PRODUÇÃO é OBRIGATÓRIA.
# SECRET_KEY=

# STT de nuvem (PADRÃO para áudio do sistema — funciona em qualquer navegador/dispositivo,
# sem download, sem WebGPU). A chave fica SÓ no servidor; os usuários não precisam de chave.
# Pegue uma grátis em https://console.groq.com/keys (free-tier generoso).
GROQ_API_KEY=
# Opcionais (defaults já apontam para a Groq):
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# (Opcional/legado) chave Gemini do protótipo — migra para config por Perfil na Fase 1.
GEMINI_API_KEY=

# Importação de YouTube: caminho do binário yt-dlp quando não está no PATH.
# YTDLP_PATH=C:/caminho/para/yt-dlp.exe

# COOP/COEP para SharedArrayBuffer (WASM multithread) — ligue só em deploy próprio
# com modelos self-hosted (senão bloqueia recursos cross-origin).
# CROSS_ORIGIN_ISOLATION=1

# ─────────────────────────── Marco 1: autenticação + multi-tenant ───────────────────────────
# DESLIGADO por padrão = self-host/local: sem login, todo request é o "dono local", app roda
# como sempre. Ligue TUDO abaixo só para um deploy PÚBLICO (SaaS), onde cada usuário tem conta.
#
# Servidor:
# AUTH_REQUIRED=1                         # exige JWT do Supabase em TODA rota /api (senão 401).
#                                         # Em NODE_ENV=production já liga por padrão (salvo =0).
# SUPABASE_URL=https://SEUPROJ.supabase.co   # deriva o JWKS (verificação assimétrica) e o issuer.
# SUPABASE_JWT_SECRET=                    # SÓ se o projeto usar o segredo HS256 legado (fallback).
# LOCAL_OWNER_ID=local-owner              # dono das linhas legadas no self-host (raramente mexer).
#
# Cliente (precisa do prefixo VITE_ para chegar ao bundle):
# VITE_SUPABASE_URL=https://SEUPROJ.supabase.co
# VITE_SUPABASE_ANON_KEY=                 # chave pública "anon" do projeto Supabase.
# VITE_AUTH_REQUIRED=1                    # mostra a tela de login (espelha o AUTH_REQUIRED acima).

# Object storage da mídia (F5-02). As QUATRO precisam estar presentes; pela metade,
# cai para filesystem em AUDIO_DIR.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Exclusão de conta (LGPD Art. 18 VI, F9-01): sem esta chave o DELETE /api/me apaga os dados
# mas NÃO revoga o login no Supabase — a conta se recria vazia no próximo acesso. A rota avisa
# em vez de fingir sucesso.
SUPABASE_SERVICE_ROLE_KEY=

# Reconciliação do contador de armazenamento (F9-02). 0 desliga.
STORAGE_RECONCILE_HOURS=24

# Modo cluster (F6-01). Vazio ou 1 = um processo.
CLUSTER_WORKERS=
